// Windows resources: the program icon and version information shown in
// Explorer's file properties. Filled in by CMake (configure_file).
#include <winver.h>

IDI_ICON1 ICON "@RECOMPSTATION_ICO@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "RecompStation"
            VALUE "FileDescription", "RecompStation"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "RecompStation"
            VALUE "LegalCopyright", "RecompStation contributors"
            VALUE "OriginalFilename", "RecompStation.exe"
            VALUE "ProductName", "RecompStation"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
